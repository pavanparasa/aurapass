#!/bin/sh
# Register the vault MIME type, the desktop entry and the icon.
set -e

if [ "$1" = "configure" ]; then
  if command -v update-mime-database > /dev/null 2>&1; then
    update-mime-database /usr/share/mime > /dev/null 2>&1 || true
  fi
  if command -v update-desktop-database > /dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications > /dev/null 2>&1 || true
  fi
  if command -v gtk-update-icon-cache > /dev/null 2>&1 && [ -d /usr/share/icons/hicolor ]; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor > /dev/null 2>&1 || true
  fi

  cat <<'MESSAGE'
AuraPass is installed.

  aurapass-desktop   the graphical application
  aurapass           the command-line tool
  aurapass-bridge    the localhost bridge used by the browser extensions

Browser extensions live in /usr/share/aurapass/extensions/ as store-ready
packages (.zip for Chromium, .xpi/.zip for Firefox) and unpacked folders.

  Chromium: chrome://extensions -> Developer mode -> Load unpacked -> chromium/
  Firefox:  about:debugging#/runtime/this-firefox -> Load Temporary Add-on ->
            firefox/manifest.json   (or install the XPI once AMO has signed it)

If Chrome is installed as a Flatpak it cannot see /usr/share. Copy the folder
into your home first, then load that path:

  cp -r /usr/share/aurapass/extensions/chromium ~/.local/share/aurapass-chromium

A locally built .crx cannot be installed by double-clicking: Chrome rejects all
off-store CRX files with CRX_REQUIRED_PROOF_MISSING. Use "Load unpacked".
MESSAGE
fi

exit 0
